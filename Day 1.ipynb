   "source": [
    "#### Write a python program to display the current date and time."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "57464ba0-8798-49c5-a4ed-978608c5ca3e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Current date and time is :\n",
      "2025-09-23 11:23:25\n"
     ]
    }
   ],
   "source": [
    "import datetime\n",
    "present = datetime.datetime.now()\n",
    "print(\"Current date and time is :\")\n",
    "print(present.strftime(\"%Y-%m-%d %H:%M:%S\"))"
   ]
